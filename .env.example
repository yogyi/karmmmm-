# =============================================================================
# Karm Baba Mart — environment variables
# Copy to `.env` at the repo root and fill in real values.
# Never commit `.env` (secrets). Safe to commit this `.env.example`.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma → Neon / Postgres)
# -----------------------------------------------------------------------------
# Neon: https://console.neon.tech → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Schema workflow (not env, but related):
#   pnpm db:migrate:dev   # create/apply locally
#   pnpm db:migrate       # deploy pending (CI / production)
#   pnpm db:push          # emergency only — avoid in prod

# Optional Prisma Studio
PRISMA_STUDIO_PORT=5555
PRISMA_STUDIO_URL=http://localhost:5555

# -----------------------------------------------------------------------------
# App / server
# -----------------------------------------------------------------------------
# Local: API + frontend share one Express process on PORT (`pnpm dev`).
PORT=8080
APP_URL=http://localhost:8080

# Extra browser origins allowed with credentials (comma-separated).
# Production example: https://app.karmbaba.com,https://www.karmbaba.com
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Express session / signing (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
NODE_ENV=development

# Legacy email/password API (POST /api/users, /api/users/login). Keep false — use Clerk.
ALLOW_LEGACY_PASSWORD_AUTH=false

# Optional: Vite-only overrides when not using the unified Express server
# WEB_PORT=5173
# BASE_PATH=/
# API_PROXY_TARGET=http://127.0.0.1:8081

# -----------------------------------------------------------------------------
# Clerk auth  https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
# Frontend (Vite — MUST use VITE_ prefix)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Backend (same publishable key + secret)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Production: use pk_live_ / sk_live_ from Clerk Dashboard.
# Add your APP_URL (and Vercel preview URLs if needed) under Clerk → Domains.

# -----------------------------------------------------------------------------
# Object storage (presigned / direct uploads)
# Driver: blob | gcs | s3 | replit | local  (omit to auto-detect)
# On Vercel: use Blob (recommended). Local disk does NOT persist on serverless.
# -----------------------------------------------------------------------------
# Preferred on Vercel — create Storage → Blob and connect to the project.
# Vercel injects BLOB_READ_WRITE_TOKEN automatically when Blob is linked.
OBJECT_STORAGE_DRIVER=blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...   # auto-set by Vercel Blob store

# Paths: /{bucket}/{prefix}  (blob uses defaults if unset)
PRIVATE_OBJECT_DIR=/karmbaba-blob/private
PUBLIC_OBJECT_SEARCH_PATHS=/karmbaba-blob/public

# --- GCS (Google Cloud Storage) ---
# OBJECT_STORAGE_DRIVER=gcs
# GCS_PROJECT_ID=your-gcp-project
# GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- S3 or Cloudflare R2 ---
# OBJECT_STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=auto
# R2_ACCOUNT_ID=                    # → https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_BUCKET=

# --- Local disk (development only) ---
# OBJECT_STORAGE_DRIVER=local
# LOCAL_OBJECT_DIR=./data/objects

# --- Replit legacy only ---
# OBJECT_STORAGE_DRIVER=replit
# REPLIT_SIDECAR_ENDPOINT=http://127.0.0.1:1106
# REPL_ID=                          # auto-set on Replit

# -----------------------------------------------------------------------------
# Vercel (Project → Settings)
# Root Directory: artifacts/api-server   (or repo root — both vercel.json files work)
# Framework Preset: Other
# Output Directory: EMPTY
# Build Command: EMPTY (use vercel.json)
# Install Command: EMPTY (use vercel.json)
#
# GST live verification (gstinapi.in — https://www.gstinapi.in/docs)
# Header: x-api-key (keys start with gak_). Never expose to the browser.
# Legacy GSTVerify: set GST_VERIFY_PROVIDER=gstverify and base https://gstverify.co.in
# -----------------------------------------------------------------------------
# GST_VERIFY_API_KEY=gak_your_gstinapi_key
# GST_VERIFY_API_BASE_URL=https://www.gstinapi.in

# GST certificate OCR (RapidAPI) — Verified badge unlocks only after OCR pass.
# Never put this key in the frontend. Rotate if it was shared in chat/screenshots.
# GST_CERTIFICATE_OCR_RAPIDAPI_KEY=your_rapidapi_key
# GST_CERTIFICATE_OCR_RAPIDAPI_HOST=gst-certificate-ocr.p.rapidapi.com

# -----------------------------------------------------------------------------
# OTP delivery — Twilio Verify (preferred for email + WhatsApp)
# Create a Verify service: https://console.twilio.com → Verify → Services
# API keys: https://console.twilio.com → Account → API keys & tokens
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxx
# TWILIO_API_KEY_SECRET=your_api_key_secret
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # fallback Messages API (custom OTP body)
# TWILIO_AUTH_TOKEN=                             # legacy; use API key instead in production

# -----------------------------------------------------------------------------
# Transactional email fallback (when Twilio Verify is not configured)
# https://resend.com → API Keys. Without a key, OTP is logged in development only.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Karm Baba <noreply@yourdomain.com>"

# -----------------------------------------------------------------------------
# WhatsApp OTP fallback — Meta Cloud API (if not using Twilio Verify / Messages)
# Without credentials, codes are logged in development only (previewCode in API).
# -----------------------------------------------------------------------------
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_OTP_TEMPLATE=  # optional approved template name
# META_WHATSAPP_OTP_LANG=en

# Environment Variables (Production / Preview):
#   DATABASE_URL
#   APP_URL                    # https://your-domain.vercel.app
#   CORS_ORIGINS              # include production + preview origins
#   SESSION_SECRET
#   CLERK_PUBLISHABLE_KEY
#   CLERK_SECRET_KEY
#   VITE_CLERK_PUBLISHABLE_KEY  # required at BUILD time for the frontend
#   OBJECT_STORAGE_DRIVER=blob + BLOB_READ_WRITE_TOKEN  # Vercel Storage → Blob
#   GST_VERIFY_API_KEY + GST_VERIFY_API_BASE_URL  # India live GST (gstinapi.in)
#   GST_CERTIFICATE_OCR_RAPIDAPI_KEY  # RapidAPI GST Certificate OCR (Verified badge)
#   GST_CERTIFICATE_OCR_RAPIDAPI_HOST  # optional, default gst-certificate-ocr.p.rapidapi.com
#   TWILIO_ACCOUNT_SID + TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET + TWILIO_VERIFY_SERVICE_SID
#   RESEND_API_KEY + EMAIL_FROM  # email OTP fallback only
#   TWILIO_WHATSAPP_FROM or META_WHATSAPP_*  # WhatsApp fallback
#   NODE_ENV=production
# -----------------------------------------------------------------------------
