# Neon Postgres (paste your connection string from https://console.neon.tech)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Schema changes: prefer versioned migrations over db push
#   pnpm db:migrate:dev   # create/apply locally
#   pnpm db:migrate       # deploy pending (CI / post-merge)
#   pnpm db:push          # emergency only

# Local app URLs
PORT=8080
APP_URL=http://localhost:8080
# Comma-separated extra browser origins allowed with credentials (optional).
# Example: https://app.karmbaba.com,https://www.karmbaba.com
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PRISMA_STUDIO_PORT=5555
PRISMA_STUDIO_URL=http://localhost:5555

# API server
# API + frontend share PORT in local `pnpm dev` (single Express server).
SESSION_SECRET=change-me

# Legacy password register/login (POST /api/users, /api/users/login). Off by default — use Clerk.
ALLOW_LEGACY_PASSWORD_AUTH=false

# Clerk (https://dashboard.clerk.com → API Keys)
# Frontend (Vite requires VITE_ prefix)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Backend
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Object storage (presigned uploads)
# Driver: gcs | s3 | replit  (omit to auto-detect from credentials / REPL_ID)
# Prefer gcs or s3/R2 off Replit — replit uses a local sidecar and fails on Vercel.
OBJECT_STORAGE_DRIVER=gcs

# Paths: /{bucket}/{prefix}  (used by all drivers)
PRIVATE_OBJECT_DIR=/your-bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public

# --- GCS (recommended for Google Cloud) ---
# GCS_PROJECT_ID=your-gcp-project
# Paste the full service-account JSON (Vercel-friendly) OR set GOOGLE_APPLICATION_CREDENTIALS=/path/key.json
# GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- S3 or Cloudflare R2 ---
# OBJECT_STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=auto
# R2_ACCOUNT_ID=           # sets endpoint to https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
# # or S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# --- Replit legacy (sidecar on 127.0.0.1:1106) ---
# OBJECT_STORAGE_DRIVER=replit
# REPLIT_SIDECAR_ENDPOINT=http://127.0.0.1:1106
